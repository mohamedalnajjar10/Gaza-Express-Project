generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  store_owner
  driver
  admin
}

enum LanguagePref {
  ar
  en
}

enum OtpType {
  PHONE_VERIFICATION
  PASSWORD_RESET
  LOGIN
}

model User {
  user_id           Int            @id @default(autoincrement()) @map("user_id")
  full_name         String         @db.VarChar(200)
  full_name_ar      String?        @db.VarChar(200)
  phone             String         @unique @db.VarChar(20)
  email             String?        @unique @db.VarChar(255)
  password_hash     String         @db.VarChar(255)
  role              UserRole       @default(customer)
  pendingSignupRole UserRole?      @map("pending_signup_role")
  avatar            String?
  googleId          String?        @unique
  provider          String         @default("local") 
  profile_photo_url String?        @db.VarChar(500)
  is_active         Boolean        @default(true) @map("is_active")
  is_verified       Boolean        @default(false) @map("is_verified")
  addressPromptedAt DateTime? @map("address_prompted_at")
  defaultAddressId Int? @map("default_address_id")
  defaultAddress DeliveryAddress? @relation("DefaultAddress", fields: [defaultAddressId], references: [id], onDelete: SetNull)
  sessionVersion    Int            @default(0) @map("session_version")
  language_pref     LanguagePref   @default(ar) @map("language_pref")
  device_token      String?        @db.VarChar(500)
  last_seen_at      DateTime?      @map("last_seen_at")
  created_at        DateTime       @default(now()) @map("created_at")
  updated_at        DateTime       @updatedAt @map("updated_at")
  
  otp_codes         OtpCode[]
  refresh_tokens    RefreshToken[]
  stores            Store[]
  reviews           Review[]
  storeFavorites    StoreFavorite[]      
  productFavorites  ProductFavorite[]   

  notifications Notification[]
  storeModerationEvents StoreModerationEvent[]
  deliveryAddresses DeliveryAddress[]
  cart ShoppingCart?
  driverProfile DriverProfile?
  managedDeliveryCompany DeliveryCompany?
  orders CustomerOrder[] @relation("CustomerOrders")
  assignedOrders CustomerOrder[] @relation("DriverOrders")
  orderEvents OrderEvent[]

  @@index([defaultAddressId], map: "users_default_address_id_idx")
  @@map("users")
}

model OtpCode {
  otp_id      Int       @id @default(autoincrement()) @map("otp_id")
  user_id     Int?      @map("user_id")
  phone       String    @db.VarChar(20)
  code        String    @db.VarChar(64)
  challenge   String?   @db.VarChar(36)
  attempts    Int       @default(0)
  type        OtpType
  is_used     Boolean   @default(false) @map("is_used")
  expires_at  DateTime  @map("expires_at")
  created_at  DateTime  @default(now()) @map("created_at")
  
  user        User?     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([phone])
  @@index([phone, type, created_at])
  @@index([code])
  @@index([expires_at])
  @@map("otp_codes")
}

model RefreshToken {
  token_id     Int      @id @default(autoincrement()) @map("token_id") 
  user_id      Int      @map("user_id") 
  token        String   @unique @db.VarChar(500)
  expires_at   DateTime @map("expires_at")
  revoked_at   DateTime? @map("revoked_at")
  created_at   DateTime @default(now()) @map("created_at")
  
  user         User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@index([token])
  @@index([expires_at])
  @@map("refresh_tokens")
}

model Category {
  id            Int             @id @default(autoincrement())  
  name          String          @unique
  nameAr        String?
  description   String?
  image         String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  subCategories SubCategory[]
  @@map("categories")
}

model SubCategory {
  id          Int      @id @default(autoincrement())  
  name        String
  nameAr      String?
  description String?
  image       String?
  isActive    Boolean  @default(true)
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([name, categoryId])
  @@map("sub_categories")
}

enum StorePlanTier {
  FREE
  PRO
}

model StoreCategory {
  categoryId           Int         @id @default(autoincrement())  
  nameAr               String      @unique
  nameEn               String?     @unique
  iconUrl              String?     @map("icon_url")
  colorHex             String?     @default("#4CAF50") @map("color_hex")
  sortOrder            Int         @default(0) @map("sort_order")
  isActive             Boolean     @default(true) @map("is_active")
  defaultCommissionBps Int?        @map("default_commission_bps")
  createdAt            DateTime    @default(now()) @map("created_at")

  stores        Store[]
  
  @@map("store_categories")
}

model Store {
  bankTransferPhone String? @db.VarChar(10)
  storeId         Int       @id @default(autoincrement()) @map("store_id") 
  ownerId         Int       @map("owner_id") 
  categoryId      Int       @map("category_id") 
  areaId          Int       @map("area_id") 
  
  storeName       String    @map("store_name")
  storeNameAr     String?   @map("store_name_ar")
  description     String?   @db.Text
  descriptionAr   String?   @db.Text @map("description_ar")
  logoUrl         String?   @map("logo_url")
  coverImageUrl   String?   @map("cover_image_url")
  
  phone           String?
  whatsappNumber  String?   @map("whatsapp_number")
  fullAddress     String?   @db.Text @map("full_address")
  fullAddressAr   String?   @db.Text @map("full_address_ar")
  latitude        Decimal?  @db.Decimal(10, 8)
  longitude       Decimal?  @db.Decimal(11, 8)
  
  opensAt         String?   @default("08:00:00") @map("opens_at")
  closesAt        String?   @default("22:00:00") @map("closes_at")
  workingDays     String?   @default("saturday,sunday,monday,tuesday,wednesday,thursday") @map("working_days")
  
  minOrderAmount        Decimal       @default(0) @map("min_order_amount") @db.Decimal(8, 2)
  estimatedPrepMin      Int           @default(30) @map("estimated_prep_min")
  deliveryRangeKm       Decimal       @default(10) @map("delivery_range_km") @db.Decimal(5, 2)
  planTier              StorePlanTier @default(FREE) @map("plan_tier")
  commissionBps         Int?          @map("commission_bps")
  deliveryBaseFee       Decimal?      @map("delivery_base_fee") @db.Decimal(8, 2)
  deliveryPerKmFee      Decimal?      @map("delivery_per_km_fee") @db.Decimal(8, 2)
  freeDeliveryThreshold Decimal?      @map("free_delivery_threshold") @db.Decimal(8, 2)
  
  status          StoreStatus @default(PENDING_APPROVAL)
  isOpenNow       Boolean   @default(true) @map("is_open_now")
  totalOrders     Int       @default(0) @map("total_orders")
  avgRating       Decimal   @default(0) @map("avg_rating") @db.Decimal(3, 2)
  
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  owner           User             @relation(fields: [ownerId], references: [user_id])
  storeCategory   StoreCategory    @relation(fields: [categoryId], references: [categoryId])
  productCategories ProductCategory[]
  storeImages     StoreImage[]
  products        Product[]
  reviews         Review[]
  favorites       StoreFavorite[]

  @@index([ownerId])
  @@index([categoryId])
  @@index([status])
  @@index([status, avgRating(sort: Desc), storeId])
  @@index([status, avgRating])
  @@index([status, estimatedPrepMin])
  @@index([status, createdAt])
  @@index([status, categoryId, areaId])
  orders CustomerOrder[]
  moderationEvents StoreModerationEvent[]
  deliveryContracts StoreDeliveryContract[]

  @@map("stores")
}

enum StoreStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  CLOSED_TEMPORARILY
  INACTIVE
}

model StoreImage {
  imageId    Int      @id @default(autoincrement()) @map("image_id")
  storeId    Int      @map("store_id")
  imageUrl   String   @map("image_url")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  store      Store    @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@map("store_images")
}

model ProductCategory {
  prodCategoryId  Int      @id @default(autoincrement()) @map("prod_category_id")
  storeId         Int      @map("store_id")
  nameAr          String   @map("name_ar")
  nameEn          String?  @map("name_en")
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")

  store           Store    @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  products        Product[]
  parentId Int? @map("parent_id")
  parent ProductCategory? @relation("ProductCategoryTree", fields: [parentId], references: [prodCategoryId], onDelete: SetNull)
  children ProductCategory[] @relation("ProductCategoryTree")

  @@index([parentId])
  @@index([storeId])
  @@map("product_categories")
}

model Product {
  productId          Int       @id @default(autoincrement()) @map("product_id")
  storeId            Int       @map("store_id")
  prodCategoryId     Int?      @map("prod_category_id")
  nameAr             String    @map("name_ar")
  nameEn             String?   @map("name_en")
  descriptionAr      String?   @db.Text @map("description_ar")
  descriptionEn      String?   @db.Text @map("description_en")
  imageUrl           String?   @map("image_url")
  estimatedPriceMin  Decimal   @default(0) @map("estimated_price_min") @db.Decimal(10, 2)
  estimatedPriceMax  Decimal   @default(0) @map("estimated_price_max") @db.Decimal(10, 2)
  priceNoteAr        String?   @map("price_note_ar")
  unit               String?
  unitAr             String?   @map("unit_ar")
  isAvailable        Boolean   @default(true) @map("is_available")
  isPriceFixed       Boolean   @default(false) @map("is_price_fixed")
  sortOrder          Int       @default(0) @map("sort_order")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  store              Store     @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  productCategory    ProductCategory? @relation(fields: [prodCategoryId], references: [prodCategoryId], onDelete: SetNull)
  soldQuantity      BigInt    @default(0) @map("sold_quantity")
  productOptions     ProductOption[]
  favorites          ProductFavorite[]

  @@index([storeId])
  @@index([storeId, isAvailable, sortOrder, productId])
  @@index([storeId, isAvailable, soldQuantity(sort: Desc), productId], map: "products_store_availability_sales_idx")
  @@index([storeId, sortOrder, productId])
  @@map("products")
}

model ProductOption {
  optionId     Int      @id @default(autoincrement()) @map("option_id") 
  productId    Int      @map("product_id")
  optionName   String   @map("option_name")
  optionNameAr String?  @map("option_name_ar")
  extraCost    Decimal  @default(0) @map("extra_cost") @db.Decimal(8, 2)
  isAvailable  Boolean  @default(true) @map("is_available")

  product      Product  @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@map("product_options")
}

model Review {
  reviewId    Int      @id @default(autoincrement()) @map("review_id")
  storeId     Int      @map("store_id")
  userId      Int      @map("user_id")
  rating      Int      @db.SmallInt
  comment     String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  store       Store    @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@unique([storeId, userId])
  @@index([storeId, createdAt(sort: Desc), reviewId(sort: Desc)])
  @@map("reviews")
}

model StoreFavorite {
  favoriteId  Int      @id @default(autoincrement()) @map("favorite_id")
  userId      Int      @map("user_id") 
  storeId     Int      @map("store_id") 
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  store       Store    @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@unique([userId, storeId])
  @@map("store_favorites")
}

model ProductFavorite {
  favoriteId  Int      @id @default(autoincrement()) @map("favorite_id") 
  userId      Int      @map("user_id") 
  productId   Int      @map("product_id") 
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("product_favorites")
}

enum OrderStatus {
  PENDING
  QUOTED
  ACCEPTED
  READY
  ASSIGNED
  IN_TRANSIT
  DELIVERED
  REJECTED
  CANCELLED
}

model DeliveryAddress {
  id Int @id @default(autoincrement())
  customerId Int
  label String @db.VarChar(80)
  address String @db.VarChar(500)
  latitude Decimal @db.Decimal(10, 8)
  longitude Decimal @db.Decimal(11, 8)
  area String? @db.VarChar(120)
  residenceType String @default("HOUSE") @map("residence_type") @db.VarChar(20)
  building String? @db.VarChar(160)
  floor String? @db.VarChar(40)
  street String? @db.VarChar(160)
  phone String? @db.VarChar(20)
  directions String? @db.VarChar(300)
  defaultFor User[] @relation("DefaultAddress")
  customer User @relation(fields: [customerId], references: [user_id], onDelete: Cascade)

  @@index([customerId, id])
  @@map("delivery_addresses")
}

model ShoppingCart {
  customerId Int @id
  storeId Int?
  items Json
  version Int @default(1)
  customer User @relation(fields: [customerId], references: [user_id], onDelete: Cascade)

  @@map("shopping_carts")
}

model CustomerOrder {
  id Int @id @default(autoincrement())
  customerId Int
  storeId Int
  driverId Int?
  activeDriverId Int? @unique
  offeredDriverId Int?
  offerExpiresAt DateTime?
  dispatchOpenedAt DateTime?
  deliveryCompanyId Int?
  deliveryNonce String? @db.VarChar(36)
  deliveryCodeExpiresAt DateTime?
  deliveryCodeAttempts Int @default(0)
  paymentMethod PaymentMethod @default(CASH)
  payment Payment?
  idempotencyKey String @db.VarChar(64)
  requestHash String @db.Char(64)
  status OrderStatus @default(PENDING)
  version Int @default(1)
  addressSnapshot Json
  itemSnapshots Json
  storeName String
  currency String @db.Char(3)
  estimatedMin Decimal @db.Decimal(14, 2)
  estimatedMax Decimal @db.Decimal(14, 2)
  minimumAmount Decimal @db.Decimal(14, 2)
  proposedTotal Decimal? @db.Decimal(14, 2)
  finalTotal Decimal? @db.Decimal(14, 2)
  deliveryDistanceKm Decimal? @db.Decimal(8, 2)
  deliveryFee Decimal @default(0) @db.Decimal(14, 2)
  rewardPointsUsed Int @default(0)
  rewardPointsEarned Int @default(10)
  rewardDiscountRate Int @default(0)
  rewardDiscount Decimal @default(0) @db.Decimal(14, 2)
  requiresQuote Boolean
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer User @relation("CustomerOrders", fields: [customerId], references: [user_id], onDelete: Restrict)
  driver User? @relation("DriverOrders", fields: [driverId], references: [user_id], onDelete: Restrict)
  deliveryCompany DeliveryCompany? @relation(fields: [deliveryCompanyId], references: [id], onDelete: Restrict)
  store Store @relation(fields: [storeId], references: [storeId], onDelete: Restrict)
  events OrderEvent[]

  @@unique([customerId, idempotencyKey])
  @@index([customerId, id])
  @@index([storeId, id])
  @@index([driverId, id])
  @@index([customerId, status])
  @@index([offeredDriverId, offerExpiresAt])
  @@index([deliveryCompanyId, driverId, status, dispatchOpenedAt], map: "customer_orders_dispatch_idx")
  @@map("customer_orders")
}

model OrderEvent {
  id Int @id @default(autoincrement())
  orderId Int
  actorId Int
  actorRole UserRole
  version Int
  action String @db.VarChar(30)
  fromStatus OrderStatus?
  toStatus OrderStatus
  details Json?
  createdAt DateTime @default(now())
  order CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [user_id], onDelete: Restrict)

  @@unique([orderId, version])
  @@index([actorId])
  @@map("order_events")
}


enum PaymentMethod {
  CASH
  BANK_TRANSFER
  ELECTRONIC
}

enum PaymentStatus {
  DUE
  PAID
  VOID
  REFUND_REQUIRED
  REFUNDED
}

model DriverProfile {
  userId Int @id
  approved Boolean @default(false)
  available Boolean @default(false)
  deliveryCompanyId Int?
  latitude Decimal? @db.Decimal(10, 8)
  longitude Decimal? @db.Decimal(11, 8)
  locationUpdatedAt DateTime?
  dispatchAreaId Int?
  user User @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  deliveryCompany DeliveryCompany? @relation(fields: [deliveryCompanyId], references: [id], onDelete: Restrict)

  @@index([deliveryCompanyId, available, approved, locationUpdatedAt], map: "driver_profiles_dispatch_idx")
  @@map("driver_profiles")
}

model DeliveryCompany {
  id Int @id @default(autoincrement())
  name String @db.VarChar(160)
  feePerOrder Decimal @default(0) @db.Decimal(8, 2)
  managerId Int @unique
  manager User @relation(fields: [managerId], references: [user_id], onDelete: Restrict)
  drivers DriverProfile[]
  orders CustomerOrder[]
  contracts StoreDeliveryContract[]

  @@map("delivery_companies")
}

model StoreDeliveryContract {
  storeId Int
  deliveryCompanyId Int
  confirmed Boolean @default(false)
  store Store @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  deliveryCompany DeliveryCompany @relation(fields: [deliveryCompanyId], references: [id], onDelete: Cascade)

  @@id([storeId, deliveryCompanyId])
  @@index([deliveryCompanyId])
  @@map("store_delivery_contracts")
}

model Payment {
  orderId Int @id
  order CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  method PaymentMethod
  status PaymentStatus @default(DUE)
  amount Decimal @db.Decimal(14, 2)
  currency String @db.Char(3)
  recipientPhone String? @db.VarChar(10)
  storeCollected Boolean @default(false)
  receipt BankReceipt?
  bankCode String? @unique @db.VarChar(36)
  bankReference String? @unique @db.VarChar(100)
  whatsappMessageId String? @unique @db.VarChar(191)
  whatsappReceivedAt DateTime?
  collectedBy Int?
  collectedAt DateTime?
  cashHandedOverAt DateTime?
  cashHandedOverBy Int?
  commissionBpsApplied Int @default(0)
  deliveryFee Decimal @default(0) @db.Decimal(14, 2)
  companyFeeApplied Decimal @default(0) @db.Decimal(14, 2)
  storeShare Decimal @db.Decimal(14, 2)
  driverShare Decimal @db.Decimal(14, 2)
  platformShare Decimal @db.Decimal(14, 2)
  entries PaymentEntry[]

  @@map("payments")
}

model BankReceipt {
  orderId            Int       @id
  payment            Payment   @relation(fields: [orderId], references: [orderId], onDelete: Cascade, map: "bank_receipt_payment_fk")
  image              Bytes     @db.MediumBlob
  rawSha256          String?   @db.Char(64)
  perceptualHash     String?   @db.Char(16)
  imageWidth         Int?
  imageHeight        Int?
  originalFormat     String?   @db.VarChar(16)
  transferReference  String?   @db.VarChar(100)
  senderPhone        String?   @db.VarChar(20)
  verificationStatus String    @default("AUTO_CHECKED") @db.VarChar(32)
  riskLevel          String    @default("LOW") @db.VarChar(16)
  riskScore          Int       @default(0)
  forensicReport     Json?
  submittedAt        DateTime  @default(now())
  reportReason       String?   @db.VarChar(500)
  reportedBy         Int?
  reportedAt         DateTime?
  reviewedBy         Int?
  reviewedAt         DateTime?
  decision           String?   @db.VarChar(12)
  reviewNote         String?   @db.VarChar(500)

  @@index([rawSha256])
  @@index([perceptualHash])
  @@index([transferReference])
  @@index([verificationStatus, submittedAt])
  @@index([decision, reportedAt])
  @@map("bank_receipts")
}

model PaymentEntry {
  id Int @id @default(autoincrement())
  orderId Int
  payment Payment @relation(fields: [orderId], references: [orderId], onDelete: Restrict)
  kind String @db.VarChar(40)
  debit String @db.VarChar(80)
  credit String @db.VarChar(80)
  amount Decimal @db.Decimal(14, 2)
  actorId Int
  reference String? @unique @db.VarChar(150)
  createdAt DateTime @default(now())

  @@unique([orderId, kind])
  @@map("payment_entries")
}


enum SmsJobStatus {
  DELIVERED
  PENDING
  PROCESSING
  ACCEPTED
  FAILED
  UNKNOWN
  EXPIRED
}

model SmsJob {
  id String @id @db.Char(36)
  otpId Int @unique
  payload String? @db.Text
  status SmsJobStatus @default(PENDING)
  attempts Int @default(0)
  availableAt DateTime @default(now())
  expiresAt DateTime
  leaseUntil DateTime?
  resolutionActorId Int?
  resolutionReason String? @db.VarChar(250)
  providerId String? @db.VarChar(80)
  errorCode String? @db.VarChar(40)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt])
  @@index([status, expiresAt])
  @@index([status, leaseUntil])
  @@index([status, updatedAt])
  @@map("sms_jobs")
}

model Notification {
  id Int @id @default(autoincrement())
  userId Int
  eventKey String @db.VarChar(100)
  kind String @db.VarChar(50)
  orderId Int
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@unique([userId, eventKey])
  @@index([userId, id])
  @@index([createdAt])
  @@map("notifications")
}


model StoreModerationEvent {
  id Int @id @default(autoincrement())
  storeId Int
  actorId Int
  fromStatus StoreStatus
  toStatus StoreStatus
  reason String @db.VarChar(500)
  createdAt DateTime @default(now())
  store Store @relation(fields: [storeId], references: [storeId], onDelete: Restrict)
  actor User @relation(fields: [actorId], references: [user_id], onDelete: Restrict)

  @@index([storeId, id])
  @@map("store_moderation_events")
}
