enum StoreStatus {
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  CLOSED_TEMPORARILY
  INACTIVE
}

model StoreImage {
  imageId    Int      @id @default(autoincrement()) @map("image_id")
  storeId    Int      @map("store_id")
  imageUrl   String   @map("image_url")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  store      Store    @relation(fields: [storeId], references: [storeId], onDelete: Cascade)

  @@map("store_images")
}

model ProductCategory {
  prodCategoryId  Int      @id @default(autoincrement()) @map("prod_category_id")
  storeId         Int      @map("store_id")
  nameAr          String   @map("name_ar")
  nameEn          String?  @map("name_en")
  sortOrder       Int      @default(0) @map("sort_order")
  isActive        Boolean  @default(true) @map("is_active")

  store           Store    @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  products        Product[]

  @@index([storeId])
  @@map("product_categories")
}

model Product {
  productId          Int       @id @default(autoincrement()) @map("product_id")
  storeId            Int       @map("store_id")
  prodCategoryId     Int?      @map("prod_category_id")
  nameAr             String    @map("name_ar")
  nameEn             String?   @map("name_en")
  descriptionAr      String?   @db.Text @map("description_ar")
  descriptionEn      String?   @db.Text @map("description_en")
  imageUrl           String?   @map("image_url")
  estimatedPriceMin  Decimal   @default(0) @map("estimated_price_min") @db.Decimal(10, 2)
  estimatedPriceMax  Decimal   @default(0) @map("estimated_price_max") @db.Decimal(10, 2)
  priceNoteAr        String?   @map("price_note_ar")
  unit               String?
  unitAr             String?   @map("unit_ar")
  isAvailable        Boolean   @default(true) @map("is_available")
  isPriceFixed       Boolean   @default(false) @map("is_price_fixed")
  sortOrder          Int       @default(0) @map("sort_order")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  store              Store     @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  productCategory    ProductCategory? @relation(fields: [prodCategoryId], references: [prodCategoryId], onDelete: SetNull)
  productOptions     ProductOption[]
  favorites          ProductFavorite[]

  @@index([storeId])
  @@index([storeId, isAvailable, sortOrder, productId])
  @@index([storeId, sortOrder, productId])
  @@map("products")
}

model ProductOption {
  optionId     Int      @id @default(autoincrement()) @map("option_id") 
  productId    Int      @map("product_id")
  optionName   String   @map("option_name")
  optionNameAr String?  @map("option_name_ar")
  extraCost    Decimal  @default(0) @map("extra_cost") @db.Decimal(8, 2)
  isAvailable  Boolean  @default(true) @map("is_available")

  product      Product  @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@map("product_options")
}

model Review {
  reviewId    Int      @id @default(autoincrement()) @map("review_id")
  storeId     Int      @map("store_id")
  userId      Int      @map("user_id")
  rating      Int      @db.SmallInt
  comment     String?  @db.Text
