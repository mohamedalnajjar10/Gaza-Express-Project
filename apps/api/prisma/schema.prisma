generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  customer
  store_owner
  driver
  admin
}

enum LanguagePref {
  ar
  en
}

enum OtpType {
  PHONE_VERIFICATION
  PASSWORD_RESET
  LOGIN
}

model User {
  user_id           Int            @id @default(autoincrement()) @map("user_id")
  full_name         String         @db.VarChar(200)
  full_name_ar      String?        @db.VarChar(200)
  phone             String         @unique @db.VarChar(20)
  email             String?        @unique @db.VarChar(255)
  password_hash     String         @db.VarChar(255)
  role              UserRole       @default(customer)
  avatar            String?
  googleId          String?        @unique
  provider          String         @default("local") 
  profile_photo_url String?        @db.VarChar(500)
  is_active         Boolean        @default(true) @map("is_active")
  is_verified       Boolean        @default(false) @map("is_verified")
  language_pref     LanguagePref   @default(ar) @map("language_pref")
  device_token      String?        @db.VarChar(500)
  last_seen_at      DateTime?      @map("last_seen_at")
  created_at        DateTime       @default(now()) @map("created_at")
  updated_at        DateTime       @updatedAt @map("updated_at")
  
  otp_codes         OtpCode[]
  refresh_tokens    RefreshToken[]
  stores            Store[]
  reviews           Review[]
  storeFavorites    StoreFavorite[]      
  productFavorites  ProductFavorite[]   

  notifications Notification[]
  storeModerationEvents StoreModerationEvent[]
  deliveryAddresses DeliveryAddress[]
  cart ShoppingCart?
  driverProfile DriverProfile?
  orders CustomerOrder[] @relation("CustomerOrders")
  assignedOrders CustomerOrder[] @relation("DriverOrders")
  orderEvents OrderEvent[]

  @@map("users")
}

model OtpCode {
  otp_id      Int       @id @default(autoincrement()) @map("otp_id")
  user_id     Int?      @map("user_id")
  phone       String    @db.VarChar(20)
  code        String    @db.VarChar(64)
  type        OtpType
  is_used     Boolean   @default(false) @map("is_used")
  expires_at  DateTime  @map("expires_at")
  created_at  DateTime  @default(now()) @map("created_at")
  
  user        User?     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([phone])
  @@index([code])
  @@index([expires_at])
  @@map("otp_codes")
}

model RefreshToken {
  token_id     Int      @id @default(autoincrement()) @map("token_id") 
  user_id      Int      @map("user_id") 
  token        String   @unique @db.VarChar(500)
  expires_at   DateTime @map("expires_at")
  revoked_at   DateTime? @map("revoked_at")
  created_at   DateTime @default(now()) @map("created_at")
  
  user         User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@index([token])
  @@map("refresh_tokens")
}

model Category {
  id            Int             @id @default(autoincrement())  
  name          String          @unique
  nameAr        String?
  description   String?
  image         String?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  subCategories SubCategory[]
  @@map("categories")
}

model SubCategory {
  id          Int      @id @default(autoincrement())  
  name        String
  nameAr      String?
  description String?
  image       String?
  isActive    Boolean  @default(true)
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([name, categoryId])
  @@map("sub_categories")
}

model StoreCategory {
  categoryId    Int         @id @default(autoincrement())  
  nameAr        String      @unique
  nameEn        String?     @unique
  iconUrl       String?     @map("icon_url")
  colorHex      String?     @default("#4CAF50") @map("color_hex")
  sortOrder     Int         @default(0) @map("sort_order")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")

  stores        Store[]
  
  @@map("store_categories")
}

model Store {
  storeId         Int       @id @default(autoincrement()) @map("store_id") 
  ownerId         Int       @map("owner_id") 
  categoryId      Int       @map("category_id") 
  areaId          Int       @map("area_id") 
  
  storeName       String    @map("store_name")
  storeNameAr     String?   @map("store_name_ar")
  description     String?   @db.Text
  descriptionAr   String?   @db.Text @map("description_ar")
  logoUrl         String?   @map("logo_url")
  coverImageUrl   String?   @map("cover_image_url")
  
  phone           String?
  whatsappNumber  String?   @map("whatsapp_number")
  fullAddress     String?   @db.Text @map("full_address")
  fullAddressAr   String?   @db.Text @map("full_address_ar")
  latitude        Decimal?  @db.Decimal(10, 8)
  longitude       Decimal?  @db.Decimal(11, 8)
  
  opensAt         String?   @default("08:00:00") @map("opens_at")
  closesAt        String?   @default("22:00:00") @map("closes_at")
  workingDays     String?   @default("saturday,sunday,monday,tuesday,wednesday,thursday") @map("working_days") // ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ£ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ¢ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ¥ط·آ·ط¢آ£ط·آ¢ط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¹â€کط·آ¢ط¢آ¬ط·آ·ط¢آ¥ط£آ¢أ¢â€ڑآ¬ط¥â€œط·آ·ط¢آ·ط·آ¢ط¢آ£ط·آ·ط¢آ¢ط·آ¢ط¢آ¢ط·آ·ط¢آ£ط·آ¢ط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط·آ¹أ¢â‚¬ع©ط·آ·ط¢آ¢ط·آ¢ط¢آ¬ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ¦ ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ¢ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ£ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ¸ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ¸ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ¾ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ¢ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ¶ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ¸ط·آ·ط¢آ·ط·آ¢ط¢آ£ط·آ·ط¢آ¢ط·آ¢ط¢آ¢ط·آ·ط¢آ£ط·آ¢ط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط·آ¹أ¢â‚¬ع©ط·آ·ط¢آ¢ط·آ¢ط¢آ¬ط·آ·ط¢آ£ط·آ¢ط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¹â€کط·آ¢ط¢آ¬ط·آ·ط¢آ¹ط£آ¢أ¢â€ڑآ¬ط¢آ  ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ¸ط·آ·ط¢آ·ط·آ¢ط¢آ£ط·آ·ط¢آ¢ط·آ¢ط¢آ¢ط·آ·ط¢آ£ط·آ¢ط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط·آ¹أ¢â‚¬ع©ط·آ·ط¢آ¢ط·آ¢ط¢آ¬ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ¦ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ¸ط·آ·ط¢آ·ط·آ¢ط¢آ£ط·آ·ط¢آ¢ط·آ¢ط¢آ¢ط·آ·ط¢آ£ط·آ¢ط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط·آ¹أ¢â‚¬ع©ط·آ·ط¢آ¢ط·آ¢ط¢آ¬ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ  MySQL SET ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ¸ط·آ·ط¢آ·ط·آ¢ط¢آ£ط·آ·ط¢آ¢ط·آ¢ط¢آ¢ط·آ·ط¢آ£ط·آ¢ط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط·آ¹أ¢â‚¬ع©ط·آ·ط¢آ¢ط·آ¢ط¢آ¬ط·آ·ط¢آ£ط·آ¢ط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¹â€کط·آ¢ط¢آ¬ط·آ·ط¢آ¹ط£آ¢أ¢â€ڑآ¬ط¢آ ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ¸ط·آ·ط¢آ·ط·آ¢ط¢آ£ط·آ·ط¢آ¢ط·آ¢ط¢آ¢ط·آ·ط¢آ£ط·آ¢ط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â‚¬ع‘ط¢آ¬ط·آ¹أ¢â‚¬ع©ط·آ·ط¢آ¢ط·آ¢ط¢آ¬ط·آ·ط¢آ£ط·آ¢ط¢آ¢ط·آ£ط¢آ¢ط£آ¢أ¢â€ڑآ¬ط¹â€کط·آ¢ط¢آ¬ط·آ·ط¢آ¹ط£آ¢أ¢â€ڑآ¬ط¢آ ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ¢ط·آ·ط¢آ¢ط·آ¢ط¢آ·ط·آ·ط¢آ·ط·آ¢ط¢آ·ط·آ·ط¢آ¢ط·آ¢ط¢آ¹ط·آ·ط¢آ·