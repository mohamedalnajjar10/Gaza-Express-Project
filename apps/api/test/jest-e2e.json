{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "testTimeout": 20000,
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^prisma/(.*)$": "<rootDir>/../prisma/$1"
  },
  "setupFiles": [
    "<rootDir>/setup-env.ts"
  ],
  "globalSetup": "<rootDir>/endpoint-setup.cjs",
  "globalTeardown": "<rootDir>/endpoint-teardown.cjs"
}
