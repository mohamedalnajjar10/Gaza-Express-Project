NODE_ENV=production
PORT=5050
API_PREFIX=api/v1
DATABASE_URL=mysql://wasla_app:REPLACE_PASSWORD@mysql:3306/wasla
MIGRATION_DATABASE_URL=mysql://wasla_migrator:REPLACE_PASSWORD@mysql:3306/wasla
REDIS_URL=redis://redis:6379/0
JWT_SECRET=REPLACE_WITH_64_OR_MORE_RANDOM_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_OR_MORE_RANDOM_CHARACTERS
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=https://REPLACE_DOMAIN
CORS_ORIGIN=https://REPLACE_DOMAIN
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=REPLACE
GOOGLE_CLIENT_SECRET=REPLACE
GOOGLE_CALLBACK_URL=https://REPLACE_API_DOMAIN/api/v1/auth/google/callback
OTP_RESEND_COOLDOWN_MS=60000
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX_REQUESTS=300

# Private S3-compatible storage for product images.
PRODUCT_MEDIA_ENDPOINT=https://REPLACE_S3_ENDPOINT
PRODUCT_MEDIA_ACCESS_KEY=REPLACE_PRODUCT_MEDIA_ACCESS_KEY
PRODUCT_MEDIA_SECRET_KEY=REPLACE_PRODUCT_MEDIA_SECRET_KEY

# Generate independently and keep stable across API replicas.
DELIVERY_CODE_SECRET=REPLACE_WITH_64_OR_MORE_RANDOM_CHARACTERS
PLATFORM_COMMISSION_BPS=0
DRIVER_FEE_ILS=0
# Set all four only to enable bank transfer checkout.
BANK_TRANSFER_INSTRUCTIONS=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Enable registration SMS after configuring and verifying the provider.
SMS_PROVIDER=disabled
SMS_OUTBOX_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# Optional separate Redis service dedicated to disposable catalog keys.
CATALOG_CACHE_URL=
